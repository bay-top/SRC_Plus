{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "srcplus-cardnews",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cardnews-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "cardnews-assets"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "cardnews-jobs" }
    ],
    "consumers": [
      {
        "queue": "cardnews-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "cardnews-jobs-dlq"
      }
    ]
  },
  "vars": {
    "GITHUB_OWNER": "bay-top",
    "GITHUB_REPO": "SRC_Plus",
    "GITHUB_BRANCH": "main",
    "ALLOWED_CHAT_ID": "",
    "TEXT_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "TEXT_FALLBACK_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "TEXT_PROVIDER": "auto",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    "IMAGE_FALLBACK_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "IMAGE_PROVIDER": "auto",
    "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "VISION_PROVIDER": "auto",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_TEXT_MODEL": "gpt-4o-mini",
    "OPENAI_IMAGE_MODEL": "gpt-image-1",
    "OPENAI_VISION_MODEL": "gpt-4o-mini",
    "VISION_QA_MODE": "advisory",
    "IMAGE_WIDTH": "960",
    "IMAGE_HEIGHT": "1280"
  }
}
